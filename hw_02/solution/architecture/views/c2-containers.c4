// views/c2-containers.c4 — Containers + протоколы на рёбрах

views {
  view bookly-c2 {
    title 'Bookly — Containers (C2)'
    description 'Декомпозиция на сервисы и протоколы.
Sync: REST/GraphQL (edge) / gRPC (internal). Async: Kafka.
Saga: только Booking инициирует hold/confirm/release; Inventory TTL → inventory.released.'

    include bookly
    include bookly.gateway
    include bookly.identity
    include bookly.catalog
    include bookly.search
    include bookly.inventory
    include bookly.booking
    include bookly.payment
    include bookly.notification
    include bookly.kafka
    include bookly.redis

    // PostgreSQL per service + OpenSearch
    include bookly.db_identity
    include bookly.db_catalog
    include bookly.db_booking
    include bookly.db_inventory
    include bookly.db_payment
    include bookly.search_index

    include guest, partner
    include payment_provider, msg_gateway

    // ключевые рёбра с протоколами
    include guest -> bookly.gateway
    include partner -> bookly.gateway

    include bookly.gateway -> bookly.identity
    include bookly.gateway -> bookly.search
    include bookly.gateway -> bookly.catalog
    include bookly.gateway -> bookly.booking
    include bookly.gateway -> bookly.payment

    include bookly.booking -> bookly.inventory
    include bookly.booking -> bookly.payment
    include bookly.booking -> bookly.catalog

    include bookly.catalog -> bookly.kafka
    include bookly.inventory -> bookly.kafka
    include bookly.booking -> bookly.kafka
    include bookly.payment -> bookly.kafka
    include bookly.search -> bookly.kafka
    include bookly.notification -> bookly.kafka

    include bookly.identity -> bookly.db_identity
    include bookly.catalog -> bookly.db_catalog
    include bookly.booking -> bookly.db_booking
    include bookly.inventory -> bookly.db_inventory
    include bookly.payment -> bookly.db_payment
    include bookly.search -> bookly.search_index

    include bookly.gateway -> bookly.redis
    include bookly.search -> bookly.redis
    include bookly.inventory -> bookly.redis

    include bookly.payment -> payment_provider
    include payment_provider -> bookly.gateway
    include bookly.notification -> msg_gateway

    autoLayout LeftRight 180 120
  }
}
