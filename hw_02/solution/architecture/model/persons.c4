// persons.c4 — акторы сервиса бронирования

model {
  guest = person 'Гость' {
    #personTag
    description 'Ищет объект, бронирует, оплачивает, отменяет.
Клиенты: web SPA и mobile app.'
  }

  partner = person 'Партнёр (владелец объекта)' {
    #personTag
    description 'Управляет каталогом объектов, тарифами и аллотментом.
Получает уведомления о бронированиях.'
  }

  admin = person 'Оператор / Админ' {
    #personTag
    description 'Поддержка гостей, разбор спорных отмен и возвратов,
модерация каталога.'
  }
}
