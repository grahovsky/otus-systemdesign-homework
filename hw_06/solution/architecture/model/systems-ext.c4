// systems-ext.c4 — внешние системы

model {
  mobile_app = system 'Mobile App + SDK' {
    #external
    description 'Приложение владельца (person app_owner) с встроенным SDK телеметрии.
Технический источник событий: не сам конечный пользователь приложения, а SDK внутри его
приложения — батчит и отправляет события, тянет конфиг sampling/feature flags.'
  }
}
