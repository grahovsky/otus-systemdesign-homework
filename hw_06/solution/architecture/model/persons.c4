// persons.c4 — акторы системы

model {
  app_owner = person 'Владелец приложения' {
    #personTag
    description 'Разработчик/product-owner мобильного приложения — клиент платформы.
Регистрирует приложение и API-ключи, настраивает определения воронок/метрик, sampling
для SDK и пороговые алерты, читает аналитику через Query API, принимает webhook
при срабатывании правила.'
  }
}
